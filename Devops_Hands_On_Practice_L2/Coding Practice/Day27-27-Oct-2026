## 2 

  resource "aws_dynamodb_table" "Aditya_table" {
  name           = "Aditya-table"
  hash_key       = "id"
  billing_mode   = "PAY_PER_REQUEST"
  attribute {
    name = "id"
    type = "S"
  }
}


