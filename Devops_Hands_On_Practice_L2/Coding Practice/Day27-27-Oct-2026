## 3 


---
apiVersion: kubeless.io/v1beta1
kind: Function
metadata:
  name: Aditya-lambda
  namespace: default
spec:
  runtime: nodejs14
  handler: index.handler
  function: |
    module.exports = function(event, context) {
      context.succeed('Hello World');
    };
---

####################################################

## 4

pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                echo 'Building Lambda function package...'
                sh 'zip -r lambda.zip lambda/'
            }
        }
        stage('Deploy to Lambda') {
            steps {
                script {
                    sh 'aws lambda update-function-code --function-name Aditya-lambda --zip-file fileb://lambda.zip'
                }
            }
        }
    }
}



