## 2
resource "aws_api_gateway_rest_api" "Aditya_api" {
  name        = "Aditya-api"
  description = "Aditya API"
}

resource "aws_lambda_function" "Aditya_lambda" {
  function_name = "Aditya-lambda"
  runtime       = "python3.8"
  role          = aws_iam_role.lambda_exec_role.arn
  handler       = "lambda_function.lambda_handler"
  filename      = "lambda.zip"
}

resource "aws_api_gateway_integration" "lambda_integration" {
  rest_api_id = aws_api_gateway_rest_api.Aditya_api.id
  resource_id = aws_api_gateway_resource.Aditya_resource.id
  http_method = aws_api_gateway_method.Aditya_method.http_method
  integration_http_method = "POST"
  type = "AWS_PROXY"
  uri  = aws_lambda_function.Aditya_lambda.invoke_arn
}

