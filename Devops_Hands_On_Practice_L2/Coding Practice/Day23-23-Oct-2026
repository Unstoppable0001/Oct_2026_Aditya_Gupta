## 4

# Multi-Stage Docker Build
# Stage 1 — Build Stage
FROM maven:3.9-eclipse-temurin-17 AS builder
WORKDIR /opt/Aditya/java-build
COPY . /opt/Aditya/java-build/
RUN mvn clean package

# Stage 2 — Production Stage
FROM tomcat:9
WORKDIR /usr/local/tomcat/webapps
COPY --from=builder /opt/Aditya/java-build/target/*.war /usr/local/tomcat/webapps/
EXPOSE 8080
CMD ["catalina.sh", "run"]

# Real Paths
/opt/Aditya/java-build
/usr/local/tomcat/webapps