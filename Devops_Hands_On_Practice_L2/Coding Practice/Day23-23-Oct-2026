## 3
pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                echo 'Building Lambda function...'
                sh 'zip -r lambda.zip lambda/'
            }
        }
        stage('Deploy to AWS Lambda') {
            steps {
                script {
                    sh 'aws lambda update-function-code --function-name Aditya-lambda --zip-file fileb://lambda.zip'
                }
            }
        }
    }
}


stages:
  - build
  - deploy

build:
  stage: build
  script:
    - zip -r lambda.zip lambda/

deploy:
  stage: deploy
  script:
    - aws lambda update-function-code --function-name Aditya-lambda --zip-file fileb://lambda.zip
 

