## 3
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: Aditya-web-policy
spec:
  podSelector:
    matchLabels:
      app: Aditya-web-app
  policyTypes:
    - Ingress
    - Egress
  ingress:
    - from:
        - podSelector:
            matchLabels:
              app: Aditya-api
  egress:
    - to:
        - podSelector:
            matchLabels:
              app: Aditya-database
---

